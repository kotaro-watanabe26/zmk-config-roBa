#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R             &kp T                                                                   &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &lt 4 F           &kp G                   &kp LS(LG(S))                  &kp ESCAPE       &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &kp B                   &kp SEMI                       &kp COLON        &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp TAB           &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 LANGUAGE_2  &mt LEFT_CONTROL SPACE  &mt LEFT_SHIFT LANGUAGE_1      &lt 2 BACKSPACE  &lt 1 ENTER                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        ARROW_DEVICE {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &kp LC(V)  &kp HOME           &kp UP_ARROW     &kp END          &none
&none           &none         &none         &none         &none         &trans           &none   &kp LC(C)  &kp LEFT_ARROW     &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp RIGHT_SHIFT
&bt BT_CLR      &none         &none         &none         &none         &bootloader      &none   &kp LC(X)  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none            &none
&bt BT_CLR_ALL  &none         &none         &trans        &trans        &trans           &trans  &trans                                                          &none
            >;
        };

        NUM_FUNCTION {
            bindings = <
&none   &kp F7  &kp F8  &kp F9  &kp F12                      &kp ASTERISK  &kp N7        &kp N8        &kp N9        &kp PLUS
&none   &kp F4  &kp F5  &kp F6  &kp F11  &none       &none   &kp SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&none   &kp F1  &kp F2  &kp F3  &kp F10  &none       &none   &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &trans                                                  &none
            >;
        };

        SYMBOL {
            bindings = <
&none  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &none                       &kp GRAVE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON   &kp COLON
&none  &kp DOLLAR       &kp PERCENT   &kp CARET             &none   &trans      &none   &kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT         &kp DOUBLE_QUOTES
&none  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &none   &none       &none   &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp UNDERSCORE  &kp NON_US_BACKSLASH
&none  &none            &none         &trans                &trans  &trans      &trans  &trans                                                                  &none
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp LC(V)  &kp RG(LEFT_ARROW)  &kp RG(RIGHT_ARROW)  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LC(C)  &mkp MB1            &mkp MB3             &mkp MB2   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LC(X)  &kp RA(LEFT)        &kp RA(RIGHT)        &kp LC(R)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                         &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
