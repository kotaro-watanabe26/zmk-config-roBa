#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;
    scroll-layers = <6>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <2 1>;
        };

        to_japan_layer {
            bindings = <&to 1>;
            key-positions = <9 41>;
        };

        to_us_layer {
            bindings = <&to 0>;
            key-positions = <0 33>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E    &kp R             &kp T                                                                 &kp Y        &kp U  &lt 6 I    &kp O    &kp P
&kp A             &kp S         &kp D    &lt 5 F           &kp G                   &kp ESCAPE                   &kp DELETE       &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C    &kp V             &kp B                   &kp SEMICOLON                &kp COLON        &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_WIN      &kp LEFT_ALT  &kp TAB  &lt 3 LANGUAGE_2  &mt LEFT_CONTROL SPACE  &mt LEFT_SHIFT LANGUAGE_1    &lt 2 BACKSPACE  &lt 4 ENTER                             &kp NON_US_BACKSLASH
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        japan_default_layer {
            bindings = <
&kp Q             &kp W         &kp E    &kp R             &kp T                                                                 &kp Y        &kp U  &lt 6 I    &kp O    &kp P
&kp A             &kp S         &kp D    &lt 5 F           &kp G                   &kp ESCAPE                   &kp DELETE       &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C    &kp V             &kp B                   &kp SEMICOLON                &kp JP_COLON        &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_WIN      &kp LEFT_ALT  &kp TAB  &lt 8 LANGUAGE_2  &mt LEFT_CONTROL SPACE  &mt LEFT_SHIFT LANGUAGE_1    &lt 7 BACKSPACE  &lt 4 ENTER                             &kp JP_YEN
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        number_layer {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F12                    &kp ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS
&trans  &kp F4  &kp F5  &kp F6  &kp F11            &trans  &kp SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans    &trans  &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans                                                  &trans
            >;
        };

        symbol_layer {
            bindings = <
&kp PRINTSCREEN  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &trans                    &kp GRAVE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON   &kp COLON
&trans           &kp DOLLAR       &kp PERCENT   &kp CARET             &trans            &trans  &kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT         &kp DOUBLE_QUOTES
&trans           &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &trans  &trans    &trans  &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp UNDERSCORE  &kp NON_US_BACKSLASH
&trans           &trans           &trans        &trans                &trans  &trans    &trans  &trans                                                                  &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &kp LC(V)  &kp HOME           &kp UP_ARROW     &kp END          &trans
&trans          &trans        &trans        &trans        &trans                       &trans  &kp LC(C)  &kp LEFT_ARROW     &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp RIGHT_SHIFT
&bt BT_CLR      &trans        &trans        &trans        &trans        &bootloader    &trans  &kp LC(X)  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans           &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans         &trans  &trans                                                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp LC(V)  &trans              &trans               &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &kp LC(C)  &mkp MB1            &mkp MB3             &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LC(X)  &kp RA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                        &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        japan_number_layer {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F12                    &kp JP_ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp JP_PLUS
&trans  &kp F4  &kp F5  &kp F6  &kp F11            &trans  &kp SLASH        &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans    &trans  &kp N0           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp JP_EQUAL
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans                                                     &trans
            >;
        };

        japan_symbol_layer {
            bindings = <
&kp PRINTSCREEN  &kp JP_AMPERSAND    &kp JP_ASTERISK  &kp JP_LPAREN  &trans                    &kp JP_BACKQUOTE  &kp JP_LBRACKET      &kp JP_RBRACKET      &kp SEMICOLON      &kp JP_COLON
&trans           &kp DOLLAR          &kp PERCENT      &kp JP_CARET   &trans            &trans  &kp JP_TILDE      &kp JP_LPAREN        &kp JP_RPAREN        &kp JP_QUOTE       &kp JP_DQUOTE
&trans           &kp EXCLAMATION     &kp JP_AT        &kp HASH       &trans  &trans    &trans  &kp JP_PIPE       &kp JP_LBRACE        &kp JP_RBRACE        &kp JP_UNDERSCORE  &kp JP_YEN
&trans           &trans              &trans           &trans         &trans  &trans    &trans  &trans                                                                         &trans
            >;
        };
    };
};
